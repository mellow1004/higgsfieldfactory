# Required for live copywriting. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required for live clip generation. Use KEY_ID:KEY_SECRET from
# https://cloud.higgsfield.ai (never expose this to the browser)
HIGGSFIELD_API_KEY=

# Optional — defaults shown
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# HIGGSFIELD_API_BASE=https://platform.higgsfield.ai
# SESSION_SECRET=replace-with-a-long-random-string
# FACTORY_ADMIN_USER=factory
# FACTORY_ADMIN_PASSWORD=factory
# DATA_DIR=./data
# PORT=3000

# When API keys are missing the factory falls back to a local ffmpeg
# placeholder clip so you can still test compose + the board.
# Set to 1 to force that path even when keys are present.
# FACTORY_MOCK_GENERATION=0
